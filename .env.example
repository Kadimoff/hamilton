# Hamilton.az — server mühiti. Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun.
# .env heç vaxt git-ə əlavə edilmir.

# Node serverinin portu (nginx bu porta /api/ sorğularını ötürür)
PORT=8787
# nginx və ya başqa reverse proxy arxasında işləyəndə 1 edin (IP X-Real-IP başlığından oxunur)
TRUST_PROXY=0

# SMTP (müraciətlər e-poçtla göndərilir)
SMTP_HOST=smtp.example.az
SMTP_PORT=465
# 465 üçün true, 587 (STARTTLS) üçün false
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Göndərən ünvan (boş qalsa SMTP_USER istifadə olunur)
MAIL_FROM="Hamilton.az sayt <no-reply@hamilton.az>"
# Müraciətlərin çatacağı ünvan
MAIL_TO=info@hamilton.az

# Spam qoruması: bir IP-dən pəncərə ərzində ən çox neçə müraciət
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# Yalnız lokal inkişaf üçün: SMTP olmadan məktubları .mail-outbox/ qovluğuna yazır.
# İstehsalda (NODE_ENV=production) bu rejim işləmir.
MAIL_DEV_OUTBOX=1
